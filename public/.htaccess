# Apache config for the statsights.com host.
Options -MultiViews -Indexes
DirectorySlash Off
# llms.txt, robots.txt and sitemap.xml contain accented Portuguese text
AddDefaultCharset utf-8
RewriteEngine On

# Canonical host: https://statsights.com
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Canonical paths have no trailing slash: /pt/ -> /pt, /services/ -> /services
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Clean URLs: /services -> services.html (pages are prerendered at build time)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/pt(/|$)#">
  ErrorDocument 404 /pt/404.html
</If>

# Compression: text assets shrink ~70% over the wire
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Vite puts a content hash in every /assets file name (index-BrbNvda9.js), so a changed file gets a new URL
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML, llms.txt, sitemap.xml: always revalidate so a deploy shows up immediately
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Logos, favicon, preview image: not hashed, so cache for a week
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Only this site may embed its pages in a frame (clickjacking); X-Frame-Options covers older browsers
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
